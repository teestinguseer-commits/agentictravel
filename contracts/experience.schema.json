{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lifelist.invalid/contracts/experience.schema.json",
  "title": "Experience definition (graph/experiences/*.yaml)",
  "description": "The stable, git-reviewed definition of one experience (ADR 0004). Volatile facts (offers, prices, visa rules, availability) live in Postgres; `seed` carries unverified starting values for them.",
  "type": "object",
  "required": [
    "id",
    "name",
    "lane",
    "hook",
    "place",
    "season_months",
    "scarcity",
    "budget_band",
    "segments",
    "safety_flags",
    "status",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ExperienceId"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "lane": {
      "$ref": "common.schema.json#/$defs/Lane"
    },
    "hook": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "The anchor moment, in one or two sentences"
    },
    "place": {
      "type": "object",
      "required": [
        "label",
        "countries"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/CountryCode"
          }
        }
      },
      "additionalProperties": false
    },
    "season_months": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/Month"
      },
      "description": "Empty only when the date is still to be announced"
    },
    "window_note": {
      "type": "string"
    },
    "fixed_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "scarcity": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "common.schema.json#/$defs/ScarcityType"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lead_time_note": {
      "type": "string"
    },
    "budget_band": {
      "$ref": "common.schema.json#/$defs/BudgetBand"
    },
    "segments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/Segment"
      }
    },
    "safety_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/SafetyFlag"
      }
    },
    "pairings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "with",
          "reason"
        ],
        "properties": {
          "with": {
            "$ref": "common.schema.json#/$defs/ExperienceId"
          },
          "reason": {
            "type": "string",
            "maxLength": 280
          }
        },
        "additionalProperties": false
      }
    },
    "twin_of": {
      "$ref": "common.schema.json#/$defs/ExperienceId",
      "description": "Set when this is a cheaper or easier twin of another experience"
    },
    "status": {
      "enum": [
        "live",
        "paused",
        "retired"
      ]
    },
    "seed": {
      "type": "object",
      "properties": {
        "visa_in_passport": {
          "type": "object",
          "required": [
            "effort"
          ],
          "properties": {
            "effort": {
              "$ref": "common.schema.json#/$defs/VisaEffort"
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "where_to_book": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_url",
        "checked_at",
        "verified_by",
        "confidence"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "verified_by": {
          "type": "string"
        },
        "confidence": {
          "$ref": "common.schema.json#/$defs/Confidence"
        }
      },
      "additionalProperties": false
    },
    "visa_arranged": {
      "type": "object",
      "required": [
        "countries",
        "note"
      ],
      "description": "Countries whose entry documents are arranged as part of the booking (for example the MEA yatra), so their visa rules don't apply to the traveller",
      "properties": {
        "countries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/CountryCode"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verified_facts": {
      "type": "array",
      "description": "Facts confirmed against an official source, each with its own provenance. They override the record-level provenance for that fact.",
      "items": {
        "type": "object",
        "required": [
          "field",
          "value",
          "source_url",
          "quote",
          "checked_at",
          "verified_by",
          "confidence"
        ],
        "properties": {
          "field": {
            "enum": [
              "fixed_dates"
            ]
          },
          "value": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "quote": {
            "type": "string",
            "maxLength": 600
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          },
          "verified_by": {
            "type": "string"
          },
          "confidence": {
            "$ref": "common.schema.json#/$defs/Confidence"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
