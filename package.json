{
  "name": "lifelist",
  "private": true,
  "type": "module",
  "description": "Agent-first platform for rare travel experiences",
  "engines": { "node": ">=22" },
  "scripts": {
    "graph:import-atlas": "node scripts/import-atlas.mjs",
    "graph:validate": "node scripts/validate-graph.mjs",
    "graph:seed-sql": "node scripts/build-seed-sql.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "golden:check": "node scripts/check-golden.mjs",
    "db:test": "bash scripts/test-migrations.sh",
    "preview:build": "node scripts/build-preview.mjs",
    "check": "npm run graph:validate && npm run contracts:check && npm run golden:check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
